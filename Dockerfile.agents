# varda-agents — the OCI image behind the `orchestrate` (resident) and `worker`
# sandboxes (`[sandboxes.orchestrate].image` / `[sandboxes.worker].image =
# "varda-agents:latest"`), loaded into microsandbox via `msb image load`.
#
# This file RECONSTRUCTS the previously ad-hoc image (built 2026-08-07, recipe
# recovered from `docker history varda-agents:latest`) so the recipe finally
# lives in the repo — AND adds a Rust toolchain, because worker subtasks build
# and test varda itself. Without it, a Rust bugfix worker finishes its edits but
# cannot run `cargo build`/`cargo test`, spins, and burns its whole budget in
# `needs_user` (the toolchain simply isn't in the image — not a permission gate).
#
# Build + load into msb (see `make agents-image`):
#   docker build -f Dockerfile.agents -t varda-agents:latest .
#   docker save varda-agents:latest | msb image load
#
# Both the resident and worker sandboxes share this tag; Rust is harmless weight
# for the resident and essential for the worker.

# Official Node 22 on Debian bookworm — matches the recovered base (NODE_VERSION
# 22.23.x, yarn 1.22.x) and brings node/npm the agent CLIs need.
FROM node:22-bookworm

# --- agent runtime tools + Rust build prerequisites (root) ---
# git/ca-certificates/socat: original image. socat backs the MCP broker bridge.
# build-essential/pkg-config: REQUIRED for Rust — `cargo build` links via `cc`;
#   rustc alone is not enough, the link step fails without a C toolchain.
# curl: to fetch rustup.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates socat \
        build-essential pkg-config curl \
    && rm -rf /var/lib/apt/lists/*

# Coding-agent CLIs (installed as root, globally) — matches the original image.
RUN npm install -g @anthropic-ai/claude-code @openai/codex \
    && npm cache clean --force

# Unprivileged agent user — the box IS the boundary; agents never run as root.
RUN useradd -ms /bin/bash agent
USER agent
WORKDIR /home/agent

# Pre-accept Claude Code onboarding so a headless run doesn't stall on the prompt.
RUN printf '{"hasCompletedOnboarding":true,"theme":"dark"}\n' > /home/agent/.claude.json

# --- Rust toolchain (agent user; installs under $HOME/.cargo + $HOME/.rustup) ---
ENV RUSTUP_HOME=/home/agent/.rustup \
    CARGO_HOME=/home/agent/.cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable \
    && /home/agent/.cargo/bin/rustup component add clippy rustfmt
ENV PATH="/home/agent/.cargo/bin:${PATH}"

# Fail the build loudly if any expected tool is missing.
RUN claude --version && codex --version && cargo --version && rustc --version
