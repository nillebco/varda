# varda-agents — the OCI image behind the `orchestrate` (resident) and `worker`
# sandboxes (`[sandboxes.orchestrate].image` / `[sandboxes.worker].image =
# "varda-agents:latest"`), loaded into microsandbox via `msb image load`.
#
# This file RECONSTRUCTS the previously ad-hoc image (built 2026-08-07, recipe
# recovered from `docker history varda-agents:latest`) so the recipe finally
# lives in the repo — AND adds a Rust toolchain, because worker subtasks build
# and test varda itself. Without it, a Rust bugfix worker finishes its edits but
# cannot run `cargo build`/`cargo test`, spins, and burns its whole budget in
# `needs_user` (the toolchain simply isn't in the image — not a permission gate).
#
# Build + load into msb (see `make agents-image`):
#   docker build -f Dockerfile.agents -t varda-agents:latest .
#   docker save varda-agents:latest | msb image load
#
# Both the resident and worker sandboxes share this tag; Rust is harmless weight
# for the resident and essential for the worker.

# Official Node 22 on Debian bookworm — matches the recovered base (NODE_VERSION
# 22.23.x, yarn 1.22.x) and brings node/npm the agent CLIs need.
FROM node:22-bookworm

# --- agent runtime tools + Rust build prerequisites (root) ---
# git/ca-certificates/socat: original image. socat backs the MCP broker bridge.
# build-essential/pkg-config: REQUIRED for Rust — `cargo build` links via `cc`;
#   rustc alone is not enough, the link step fails without a C toolchain.
# curl: to fetch rustup.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates socat \
        build-essential pkg-config curl \
    && rm -rf /var/lib/apt/lists/*

# Coding-agent CLIs (installed as root, globally) — matches the original image.
RUN npm install -g @anthropic-ai/claude-code @openai/codex \
    && npm cache clean --force

# opencode — Go binary, installed via the official installer (not an npm package).
# The installer puts it in /root/.opencode/bin; copy + chmod so it's on PATH for all users.
RUN curl -fsSL https://opencode.ai/install | bash \
    && cp /root/.opencode/bin/opencode /usr/local/bin/opencode \
    && chmod +x /usr/local/bin/opencode

# Unprivileged agent user — the box IS the boundary; agents never run as root.
RUN useradd -ms /bin/bash agent
USER agent
WORKDIR /home/agent

# Pre-accept Claude Code onboarding, the one-time "Bypass Permissions" warning
# (`bypassPermissionsModeAccepted`, top-level — the resident + workers launch with
# --permission-mode bypassPermissions and would otherwise prompt), AND the
# per-project trust dialog so a headless run doesn't stall/abort (#635 item 1).
# Trust is recorded per
# absolute project path under `projects[<path>].hasTrustDialogAccepted` (shape
# verified against the installed v2.1.x .claude.json). We seed the two guest paths
# this image ever runs at:
#   - /workspace                        : the orchestrate resident's rw mount
#   - /Users/nilleb/dev/nillebco/varda  : the resident's host-path rw mount AND the
#     worker worktrees — Claude keys a git worktree's trust on its MAIN repo path,
#     so this one entry also trusts every wip/ worker worktree under ~/.varda/worktrees.
# NOTE: the host path is dogfood-specific; the portable fix is to seed the guest
# project path host-side at prepare() time (tracked in #635 item 1), which would
# drop the hard-coded path from this tracked Dockerfile.
RUN printf '%s\n' '{"hasCompletedOnboarding":true,"theme":"dark","bypassPermissionsModeAccepted":true,"projects":{"/workspace":{"hasTrustDialogAccepted":true,"hasCompletedProjectOnboarding":true},"/Users/nilleb/dev/nillebco/varda":{"hasTrustDialogAccepted":true,"hasCompletedProjectOnboarding":true}}}' > /home/agent/.claude.json

# --- Rust toolchain (agent user; installs under $HOME/.cargo + $HOME/.rustup) ---
ENV RUSTUP_HOME=/home/agent/.rustup \
    CARGO_HOME=/home/agent/.cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable \
    && /home/agent/.cargo/bin/rustup component add clippy rustfmt
ENV PATH="/home/agent/.cargo/bin:${PATH}"

# codex ChatGPT-subscription auth home (#521). The `[agents.codex]` prelude decodes
# the host's ChatGPT OAuth auth.json (injected as CODEX_AUTH_B64) into
# $CODEX_HOME/auth.json at run time, and codex ALSO writes its sessions/rollouts/
# history under $CODEX_HOME — so this dir must be AGENT-OWNED and writable. We
# pre-create it here (agent-owned) so the mechanism never trips the msb `--copy-file`
# root-reownership gotcha (staging a file into a dir re-owns the dir to root, which
# would then block the uid-1001 agent from writing sessions). CODEX_HOME is pinned to
# this path via `[agents.codex.env]`; the prelude writes auth.json itself (not a
# file-target credential), so nothing here is ever root-owned.
RUN mkdir -p /home/agent/.codex

# Fail the build loudly if any expected tool is missing.
RUN claude --version && codex --version && opencode --version && cargo --version && rustc --version
